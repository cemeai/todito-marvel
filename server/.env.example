# ====================================
# Marvel Universe Explorer
# Environment Variables Template
# ====================================

# ===== MARVEL API CREDENTIALS =====
# Get your keys from: https://developer.marvel.com/account
MARVEL_PUBLIC_KEY=your_marvel_public_key_here
MARVEL_PRIVATE_KEY=your_marvel_private_key_here

# ===== SERVER CONFIGURATION =====
PORT=3000
NODE_ENV=development

# ===== CORS CONFIGURATION =====
# Development: se configura automáticamente
# Production: especificar dominios separados por comas
# CORS_ORIGINS=https://tu-dominio.com,https://www.tu-dominio.com

# ===== DATABASE CONFIGURATION =====
# MariaDB/MySQL Database Connection
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=marvel_app
DB_PORT=3306

# ===== AUTHENTICATION CONFIGURATION =====
# JWT Secret (use a strong random string in production)
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRATION=7d
BCRYPT_ROUNDS=10

# ===== SETUP INSTRUCTIONS =====
# 1. Copy this file: cp .env.example .env
# 2. Fill in your actual values in .env
# 3. Never commit .env to version control
# 4. For Marvel API keys, register at: https://developer.marvel.com