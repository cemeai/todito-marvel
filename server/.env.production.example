# ====================================
# Marvel Universe Explorer - PRODUCTION
# Environment Variables for Server
# ====================================

# ===== MARVEL API CREDENTIALS =====
MARVEL_PUBLIC_KEY=your_production_marvel_public_key
MARVEL_PRIVATE_KEY=your_production_marvel_private_key

# ===== SERVER CONFIGURATION =====
PORT=3000
NODE_ENV=production

# ===== CORS CONFIGURATION =====
# Especificar dominios de producción separados por comas
CORS_ORIGINS=https://tu-dominio.com,https://www.tu-dominio.com,https://api.tu-dominio.com

# ===== DATABASE CONFIGURATION =====
# Production Database (usar variables del servidor)
DB_HOST=your_production_db_host
DB_USER=your_production_db_user
DB_PASSWORD=your_production_db_password
DB_NAME=marvel_app_prod
DB_PORT=3306

# ===== AUTHENTICATION CONFIGURATION =====
# Usar una clave JWT ultra segura en producción
JWT_SECRET=your_super_ultra_secure_jwt_production_key_256_bits_minimum
JWT_EXPIRATION=24h
BCRYPT_ROUNDS=12

# ===== PRODUCTION NOTES =====
# 1. Cambiar todos los valores por los reales de producción
# 2. Usar HTTPS obligatoriamente
# 3. Configurar variables de entorno en tu servidor (no subir este archivo)
# 4. Usar un JWT_SECRET de al menos 256 bits
# 5. Incrementar BCRYPT_ROUNDS para mayor seguridad